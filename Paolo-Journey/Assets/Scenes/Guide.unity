--- !u!114 &960678240
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 960678237}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7496278d5a3c3ae4682b16dcadc1ef35, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  messageText: {fileID: 900120477}
  noteButton: {fileID: 957932425}
  messages:
  - "\u0E2A\u0E27\u0E31\u0E2A\u0E14\u0E35\u0E19\u0E31\u0E01\u0E40\u0E23\u0E35\u0E22\u0E19\u0E41\u0E25\u0E30\u0E1C\u0E39\u0E49\u0E1B\u0E01\u0E04\u0E23\u0E2D\u0E07\u0E17\u0E38\u0E01\u0E04\u0E19\u0E40\u0E23\u0E32\u0E21\u0E35\u0E0A\u0E37\u0E48\u0E2D\u0E27\u0E48\u0E32
    \u0E1F\u0E35\u0E21\u0E48\u0E2D\u0E19 \u0E27\u0E31\u0E19\u0E19\u0E35\u0E49\u0E40\u0E23\u0E32\u0E08\u0E30\u0E1E\u0E32\u0E17\u0E31\u0E27\u0E23\u0E4C\u0E42\u0E23\u0E07\u0E1E\u0E22\u0E32\u0E1A\u0E32\u0E25\u0E40\u0E1B\u0E32\u0E42\u0E25\u0E2A\u0E32\u0E02\u0E32\u0E1E\u0E0D\u0E32\u0E44\u0E17\u0E27\u0E48\u0E32\u0E21\u0E35\u0E01\u0E32\u0E23\u0E23\u0E31\u0E01\u0E29\u0E32\u0E2D\u0E30\u0E44\u0E23\u0E01\u0E31\u0E19\u0E1A\u0E49\u0E32\u0E07!"
  - "\u0E01\u0E48\u0E2D\u0E19\u0E17\u0E35\u0E48\u0E08\u0E30\u0E44\u0E1B\u0E17\u0E4D\u0E32\u0E01\u0E34\u0E08\u0E01\u0E23\u0E23\u0E21\u0E01\u0E31\u0E19\u0E1F\u0E35\u0E21\u0E48\u0E2D\u0E19\u0E08\u0E30\u0E1E\u0E39\u0E14\u0E40\u0E01\u0E35\u0E48\u0E22\u0E27\u0E01\u0E31\u0E1A\u0E01\u0E32\u0E23\u0E23\u0E31\u0E01\u0E29\u0E32\u0E41\u0E15\u0E48\u0E25\u0E30\n\u0E41\u0E1A\u0E1A\u0E21\u0E35\u0E2D\u0E30\u0E44\u0E23\u0E1A\u0E49\u0E32\u0E07
    \u0E41\u0E25\u0E30\u0E40\u0E23\u0E32\u0E08\u0E30\u0E15\u0E49\u0E2D\u0E07\u0E23\u0E31\u0E01\u0E29\u0E32\u0E44\u0E1B\u0E17\u0E4D\u0E32\u0E44\u0E21"
  - "\u0E17\u0E35\u0E48\u0E1F\u0E35\u0E21\u0E48\u0E2D\u0E19\u0E17\u0E4D\u0E32\u0E21\u0E32\u0E40\u0E2A\u0E19\u0E2D\u0E08\u0E30\u0E21\u0E35\u0E01\u0E32\u0E23\u0E25\u0E49\u0E32\u0E07\u0E41\u0E1C\u0E25\u0E01\u0E23\u0E13\u0E35\u0E40\u0E23\u0E32\u0E2B\u0E01\u0E25\u0E49\u0E21\u0E16\u0E49\u0E32\u0E40\u0E23\u0E32\u0E44\u0E21\u0E48\u0E23\u0E35\u0E1A\n\u0E23\u0E31\u0E01\u0E29\u0E32\u0E40\u0E1A\u0E37\u0E49\u0E2D\u0E07\u0E15\u0E49\u0E19\u0E41\u0E1C\u0E25\u0E2D\u0E32\u0E08\u0E08\u0E30\u0E15\u0E34\u0E14\u0E40\u0E0A\u0E37\u0E49\u0E2D\u0E01\u0E48\u0E2D\u0E19\u0E44\u0E14\u0E49!"
  - "\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E17\u0E35\u0E48 2 \u0E04\u0E37\u0E2D\u0E01\u0E32\u0E23\u0E01\u0E34\u0E19\u0E02\u0E49\u0E32\u0E27\u0E43\u0E2B\u0E49\u0E04\u0E23\u0E1A
    5 \u0E2B\u0E21\u0E39\u0E48\u0E08\u0E30\u0E44\u0E14\u0E49\u0E23\u0E31\u0E1A\u0E2A\u0E32\u0E23\u0E2D\u0E32\u0E2B\u0E32\u0E23\u0E43\u0E2B\u0E49\u0E04\u0E23\u0E1A
    \u0E2D\u0E22\u0E48\u0E32\u0E01\u0E34\u0E19\u0E41\u0E15\u0E48\u0E40\u0E19\u0E37\u0E49\u0E2D\u0E25\u0E30\u0E01\u0E34\u0E19\u0E1C\u0E31\u0E01\u0E14\u0E49\u0E27\u0E22\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E08\u0E30\u0E17\u0E4D\u0E32\u0E43\u0E2B\u0E49\u0E23\u0E30\u0E1A\u0E1A\u0E02\u0E31\u0E1A\u0E16\u0E48\u0E32\u0E22\u0E14\u0E35
    \u0E16\u0E48\u0E32\u0E22\u0E2A\u0E30\u0E14\u0E27\u0E01"
  - "\u0E01\u0E32\u0E23\u0E25\u0E49\u0E32\u0E07\u0E21\u0E37\u0E2D\u0E17\u0E35\u0E48\u0E16\u0E39\u0E01\u0E15\u0E49\u0E2D\u0E07
    \u0E40\u0E14\u0E47\u0E01\u0E46\u0E15\u0E49\u0E2D\u0E07\u0E25\u0E49\u0E32\u0E07\u0E21\u0E37\u0E2D\u0E17\u0E38\u0E01\u0E04\u0E23\u0E31\u0E49\u0E07\u0E17\u0E35\u0E48\u0E44\u0E1B\u0E08\u0E31\u0E1A\u0E2A\u0E34\u0E48\u0E07\u0E02\u0E2D\u0E07\u0E17\u0E35\u0E48\u0E2A\u0E01\u0E1B\u0E23\u0E01
    \u0E43\u0E0A\u0E49\u0E2A\u0E1A\u0E39\u0E48\u0E17\u0E38\u0E01\u0E04\u0E23\u0E31\u0E49\u0E07\u0E25\u0E49\u0E32\u0E07\u0E43\u0E2B\u0E49\u0E17\u0E38\u0E01\u0E21\u0E38\u0E21\u0E19\u0E34\u0E49\u0E27!"
  - "\u0E1F\u0E35\u0E21\u0E48\u0E2D\u0E19\u0E08\u0E14\u0E42\u0E19\u0E49\u0E15\u0E1A\u0E31\u0E19\u0E17\u0E36\u0E01\u0E44\u0E27\u0E49\u0E43\u0E2B\u0E49\u0E41\u0E25\u0E49\u0E27\u0E19\u0E30
    \u0E40\u0E14\u0E34\u0E19\u0E15\u0E48\u0E2D\u0E44\u0E1B\u0E17\u0E35\u0E48\u0E1B\u0E23\u0E30\u0E15\u0E39\u0E44\u0E14\u0E49\u0E40\u0E25\u0E22!"
